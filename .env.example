# Server configuration
PORT=3000
CLIENT_URL=http://localhost:5173

# Database (MySQL 8 / MariaDB)
DATABASE_URL=mysql://root:password@127.0.0.1:3306/greenly
DATABASE_SSL=false

# Authentication
JWT_SECRET=your_jwt_secret_key_here

# Web Push Notifications (VAPID) - wygeneruj przez: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:kontakt@greenly-app.pl

# External Plant Catalog API (Perenual API - https://perenual.com/docs/api)
PLANTS_API=your_perenual_api_key_here

# CRON Trigger Secret (for external ping services like cron-job.org)
CRON_SECRET=greenly_cron_secret_2026

# Transactional Emails (Resend)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=Greenly <noreply@yourdomain.com>
